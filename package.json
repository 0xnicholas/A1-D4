{
  "name": "balsa-framework",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:dist": "pnpm -r --if-present check:dist",
    "check:runtime-deps": "pnpm -r --if-present check:runtime-deps",
    "check:byte-budget": "pnpm -r --if-present check:byte-budget",
    "byte-budget:update": "pnpm -r --if-present byte-budget:update",
    "verify": "pnpm typecheck && pnpm build && pnpm test && pnpm check:dist && pnpm check:runtime-deps"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^4.0.18",
    "@standard-schema/spec": "^1.1.0",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^22.20.4",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2",
    "zod": "^4.6.5"
  }
}
