{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@balsats/core": ["./packages/core/src/index.ts"],
      "@balsats/core/*": ["./packages/core/src/*/index.ts"],
      "@balsats/ai-sdk": ["./packages/ai-sdk/src/index.ts"],
      "@balsats/croner": ["./packages/croner/src/index.ts"],
      "@balsats/mcp-client": ["./packages/mcp-client/src/index.ts"],
      "@balsats/mcp-server": ["./packages/mcp-server/src/index.ts"],
      "@balsats/otlp": ["./packages/otlp/src/index.ts"],
      "@balsats/sqlite": ["./packages/sqlite/src/index.ts"]
    },
    "noEmit": true
  }
}
